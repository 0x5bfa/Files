<UserControl
	x:Class="Files.App2.Views.TabView"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:vm="using:Files.App2.ViewModels">
	<Grid>
		<Grid
			x:Name="TitleBarDragRegion"
			MinHeight="48"
			Background="Transparent">
			<controls:TabView
				x:Name="NativeTabView"
				AllowDropTabs="False"
				CanDragTabs="False"
				CanReorderTabs="False"
				IsAddTabButtonVisible="False"
				SelectedIndex="{x:Bind ViewModel.ActiveTabIndex, Mode=OneWay}"
				SelectionChanged="NativeTabView_SelectionChanged"
				TabCloseRequested="NativeTabView_TabCloseRequested"
				TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
				<controls:TabView.TabStripHeader>
					<Button
						Width="36"
						Height="36"
						Margin="4,0"
						Padding="0"
						Command="{x:Bind ViewModel.NewTabCommand.Command}"
						ToolTipService.ToolTip="New tab"
						AutomationProperties.Name="New tab">
						<SymbolIcon Symbol="Add" />
					</Button>
				</controls:TabView.TabStripHeader>

				<controls:TabView.TabItemTemplate>
					<DataTemplate x:DataType="vm:TabViewModel">
						<controls:TabViewItem
							Header="{x:Bind Title}"
							ToolTipService.ToolTip="{x:Bind Title}" />
					</DataTemplate>
				</controls:TabView.TabItemTemplate>
			</controls:TabView>
		</Grid>
	</Grid>
</UserControl>
