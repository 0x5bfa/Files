<UserControl
	x:Class="Files.App2.Views.PaneView"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.App2.Views"
	xmlns:vm="using:Files.App2.ViewModels">
	<Border
		MinWidth="320"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		Tapped="Pane_Tapped">
		<local:PaneContentView
			ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
	</Border>
</UserControl>
