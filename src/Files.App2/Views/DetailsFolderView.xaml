<UserControl
	x:Class="Files.App2.Views.DetailsFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Files.App2.ViewModels"
	x:Name="Root">

	<ListView
		x:Name="ItemList"
		IsMultiSelectCheckBoxEnabled="False"
		ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
		SelectionMode="Extended">
		<ListView.ItemContainerStyle>
			<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			</Style>
		</ListView.ItemContainerStyle>
		<ListView.ItemTemplate>
			<DataTemplate x:DataType="vm:BrowseItemViewModel">
				<Grid ColumnSpacing="12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="100" />
						<ColumnDefinition Width="2*" />
					</Grid.ColumnDefinitions>
					<Grid Width="24" Height="24">
						<FontIcon
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="20"
							Glyph="&#xE8B7;"
							Opacity="0.5" />
						<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
					</Grid>
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						Text="{x:Bind Name}" />
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						Opacity="0.7"
						Text="{x:Bind Kind}" />
					<TextBlock
						Grid.Column="3"
						VerticalAlignment="Center"
						Opacity="0.7"
						Text="{x:Bind ReferenceText}"
						TextTrimming="CharacterEllipsis" />
				</Grid>
			</DataTemplate>
		</ListView.ItemTemplate>
	</ListView>
</UserControl>
