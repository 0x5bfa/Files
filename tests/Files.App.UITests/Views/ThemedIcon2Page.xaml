						Header="Toggle all ToggleButtons:" />

					<ToggleSwitch
						x:Name="OffEnabledToggle"
						Header="IsEnabled:"
						IsOn="False"
						OffContent="Disabled"
						OnContent="Enabled (Default)" />

				</StackPanel>
			</controls:SamplePanel.SideContent>
		</controls:SamplePanel>

		<!--  Data and brush fallbacks  -->
		<controls:SamplePanel Header="Data and brush fallbacks">
			<controls:SamplePanel.MainContent>
				<StackPanel Spacing="20">
					<TextBlock Text="Data availability" />
					<StackPanel Orientation="Horizontal" Spacing="16">
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.Complete" IconSize="32" Data="{StaticResource IconTest}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Complete" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.NullDefault" IconSize="32" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Default" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.OutlineOnly" IconSize="32" IconType="Layered" Data="{x:Bind OutlineOnlyIconData}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Outline" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.FilledOnly" IconSize="32" IconType="Outline" Data="{x:Bind FilledOnlyIconData}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Filled" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.LayeredOnly" IconSize="32" IconType="Outline" Data="{x:Bind LayeredOnlyIconData}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Layers" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.Empty" IconSize="32" Data="{x:Bind EmptyIconData}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Empty" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Width="72" Spacing="8">
							<Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Data.Malformed" IconSize="32" Data="{x:Bind MalformedIconData}">
									<AnimatedIcon.FallbackIconSource>
										<SymbolIconSource Symbol="Help" />
									</AnimatedIcon.FallbackIconSource>
								</controls:ThemedIcon2>
							</Border>
							<TextBlock HorizontalAlignment="Center" FontSize="12" Text="Malformed" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
					</StackPanel>

					<Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<TextBlock Text="Custom brush conversion" />
					<StackPanel Orientation="Horizontal" Spacing="24">
						<StackPanel Spacing="8">
							<controls:ThemedIcon2
								AutomationProperties.AutomationId="ThemedIcon2.Brush.Solid"
								Color="DeepPink"
								Foreground="Black"
								IconColorType="Custom"
								IconSize="32"
								Data="{StaticResource IconTest}" />
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Solid" />
						</StackPanel>
						<StackPanel Spacing="8">
							<controls:ThemedIcon2
								AutomationProperties.AutomationId="ThemedIcon2.Brush.Opacity"
								Foreground="Black"
								IconColorType="Custom"
								IconSize="32"
								Data="{StaticResource IconTest}">
								<controls:ThemedIcon2.Color>
									<SolidColorBrush Color="DeepPink" Opacity="0.35" />
								</controls:ThemedIcon2.Color>
							</controls:ThemedIcon2>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="35% opacity" />
						</StackPanel>
						<StackPanel Spacing="8">
							<controls:ThemedIcon2
								AutomationProperties.AutomationId="ThemedIcon2.Brush.GradientFallback"
								Foreground="Black"
								IconColorType="Custom"
								IconSize="32"
								Data="{StaticResource IconTest}">
								<controls:ThemedIcon2.Color>
									<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
										<GradientStop Offset="0" Color="Cyan" />
										<GradientStop Offset="1" Color="DeepPink" />
									</LinearGradientBrush>
								</controls:ThemedIcon2.Color>
							</controls:ThemedIcon2>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Gradient fallback" />
						</StackPanel>
						<StackPanel Spacing="8">
							<controls:ThemedIcon2
								AutomationProperties.AutomationId="ThemedIcon2.Brush.Transparent"
								Color="Transparent"
								Foreground="Black"
								IconColorType="Custom"
								IconSize="32"
								Data="{StaticResource IconTest}" />
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Transparent" />
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</controls:SamplePanel.MainContent>
		</controls:SamplePanel>

		<!--  Sizing  -->
		<controls:SamplePanel Header="Sizing">
			<controls:SamplePanel.MainContent>
				<StackPanel Spacing="24">
					<StackPanel Orientation="Horizontal" Spacing="24">
						<StackPanel Spacing="6">
							<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Size.16" IconSize="16" Data="{StaticResource IconTest}" />
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="16 px" />
						</StackPanel>
						<StackPanel Spacing="6">
							<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Size.24" IconSize="24" Data="{StaticResource IconTest}" />
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="24 px" />
						</StackPanel>
						<StackPanel Spacing="6">
							<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Size.32" IconSize="32" Data="{StaticResource IconTest}" />
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="32 px" />
						</StackPanel>
						<StackPanel Spacing="6">
							<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Size.48" IconSize="48" Data="{StaticResource IconTest}" />
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="48 px" />
						</StackPanel>
					</StackPanel>

					<Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid ColumnSpacing="24" RowSpacing="24">

					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="90" />
						<ColumnDefinition Width="90" />
						<ColumnDefinition Width="90" />
					</Grid.ColumnDefinitions>

					<!--  Row 0  -->
					<controls:ThemedIcon2
						AutomationProperties.AutomationId="ThemedIcon2.Size.Layered"
						Grid.Row="0"
						Grid.Column="0"
						IconSize="{x:Bind TestSize.Value, Mode=OneWay}"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						AutomationProperties.AutomationId="ThemedIcon2.Size.Filled"
						Grid.Row="0"
						Grid.Column="1"
						IconSize="{x:Bind TestSize.Value, Mode=OneWay}"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						AutomationProperties.AutomationId="ThemedIcon2.Size.Outline"
						Grid.Row="0"
						Grid.Column="2"
						IconSize="{x:Bind TestSize.Value, Mode=OneWay}"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Row 1  -->
					<controls:ThemedIcon2
						AutomationProperties.AutomationId="ThemedIcon2.Size.Disabled"
						Grid.Row="1"
						Grid.Column="0"
						IconSize="{x:Bind TestSize.Value, Mode=OneWay}"
						IsEnabled="False"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						AutomationProperties.AutomationId="ThemedIcon2.Size.Custom"
						Grid.Row="1"
						Grid.Column="1"
						IconSize="{x:Bind TestSize.Value, Mode=OneWay}"
						Foreground="Yellow"
						IconColorType="Custom"
						IconType="Layered"
						Data="{StaticResource IconTest}">
						<controls:ThemedIcon2.Color>
							<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
								<GradientStop Offset="0.0" Color="Cyan" />
								<GradientStop Offset="1.0" Color="DeepPink" />
							</LinearGradientBrush>
						</controls:ThemedIcon2.Color>
					</controls:ThemedIcon2>

					</Grid>
				</StackPanel>
			</controls:SamplePanel.MainContent>
			<controls:SamplePanel.SideContent>
				<StackPanel>

					<NumberBox
						x:Name="TestSize"
						Width="240"
						HorizontalAlignment="Left"
						Header="Icon size:"
						Maximum="84"
						Minimum="16"
						SpinButtonPlacementMode="Inline"
						Value="40" />

				</StackPanel>
			</controls:SamplePanel.SideContent>
		</controls:SamplePanel>

	</StackPanel>
</Page>
