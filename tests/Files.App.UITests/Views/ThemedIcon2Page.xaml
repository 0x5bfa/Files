<Page
	x:Class="Files.App.UITests.Views.ThemedIcon2Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Files.App.UITests.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<StaticResource x:Key="IconTest" ResourceKey="App.ThemedIcons2.SetSlideshow.16" />
		</ResourceDictionary>
	</Page.Resources>

	<StackPanel Spacing="24">
		<controls:SamplePanel Header="IconElement surface">
			<controls:SamplePanel.MainContent>
				<StackPanel Spacing="16">
					<TextBlock Text="Open the flyout to verify that ThemedIcon2 can be assigned directly to MenuFlyoutItem.Icon." TextWrapping="Wrap" />
					<Button AutomationProperties.AutomationId="ThemedIcon2.Surface.MenuFlyoutItem.Open" Content="Open MenuFlyoutItem">
						<Button.Flyout>
							<MenuFlyout>
								<MenuFlyoutItem AutomationProperties.AutomationId="ThemedIcon2.Surface.MenuFlyoutItem" Text="Themed icon element">
									<MenuFlyoutItem.Icon>
										<controls:ThemedIcon2
											AutomationProperties.AutomationId="ThemedIcon2.Surface.MenuFlyoutItem.Icon"
											IconSize="{x:Bind SurfaceSizeNumberBox.Value, Mode=OneWay}"
											IsFilled="{x:Bind SurfaceFilledToggle.IsOn, Mode=OneWay}"
											IsHighContrast="{x:Bind SurfaceHighContrastToggle.IsOn, Mode=OneWay}"
											IsToggled="{x:Bind SurfaceToggledToggle.IsOn, Mode=OneWay}"
											Data="{StaticResource IconTest}" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>
			</controls:SamplePanel.MainContent>
			<controls:SamplePanel.SideContent>
				<StackPanel Spacing="12">
					<ToggleSwitch
						x:Name="SurfaceToggledToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Surface.IsToggled"
						Header="IsToggled:"
						OffContent="False"
						OnContent="True" />
					<ToggleSwitch
						x:Name="SurfaceFilledToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Surface.IsFilled"
						Header="IsFilled:"
						OffContent="False"
						OnContent="True" />
					<ToggleSwitch
						x:Name="SurfaceHighContrastToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Surface.IsHighContrast"
						Header="IsHighContrast:"
						OffContent="False"
						OnContent="True" />
					<NumberBox
						x:Name="SurfaceSizeNumberBox"
						AutomationProperties.AutomationId="ThemedIcon2.Surface.IconSize"
						Header="IconSize:"
						Maximum="64"
						Minimum="16"
						SpinButtonPlacementMode="Inline"
						Value="24" />
				</StackPanel>
			</controls:SamplePanel.SideContent>
		</controls:SamplePanel>

		<!--  Dynamic state transitions  -->
		<controls:SamplePanel Header="Dynamic state transitions">
			<controls:SamplePanel.MainContent>
				<StackPanel Spacing="16">
					<TextBlock Text="These icons stay loaded while their state and palette change." TextWrapping="Wrap" />
					<Grid
						x:Name="DynamicSampleHost"
						x:Load="{x:Bind DynamicLoadedToggle.IsOn, Mode=OneWay}"
						ColumnSpacing="32">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Spacing="8">
							<Border
								Padding="16"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2
									x:Name="DynamicLayeredIcon"
									AutomationProperties.AutomationId="ThemedIcon2.Dynamic.Layered"
									IconSize="{x:Bind DynamicSizeNumberBox.Value, Mode=OneWay}"
									IconType="Layered"
									IsEnabled="{x:Bind DynamicEnabledToggle.IsOn, Mode=OneWay}"
									IsHighContrast="{x:Bind DynamicHighContrastToggle.IsOn, Mode=OneWay}"
									IsToggled="{x:Bind DynamicToggledToggle.IsOn, Mode=OneWay}"
									Data="{StaticResource IconTest}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="Layered" />
						</StackPanel>

						<StackPanel Grid.Column="1" Spacing="8">
							<Border
								Padding="16"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2
									x:Name="DynamicFilledIcon"
									AutomationProperties.AutomationId="ThemedIcon2.Dynamic.Filled"
									IconSize="{x:Bind DynamicSizeNumberBox.Value, Mode=OneWay}"
									IsEnabled="{x:Bind DynamicEnabledToggle.IsOn, Mode=OneWay}"
									IsFilled="True"
									IsHighContrast="{x:Bind DynamicHighContrastToggle.IsOn, Mode=OneWay}"
									IsToggled="{x:Bind DynamicToggledToggle.IsOn, Mode=OneWay}"
									Data="{StaticResource IconTest}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="Filled" />
						</StackPanel>

						<StackPanel Grid.Column="2" Spacing="8">
							<Border
								Padding="16"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								CornerRadius="{ThemeResource ControlCornerRadius}">
								<controls:ThemedIcon2
									x:Name="DynamicOutlineIcon"
									AutomationProperties.AutomationId="ThemedIcon2.Dynamic.Outline"
									IconSize="{x:Bind DynamicSizeNumberBox.Value, Mode=OneWay}"
									IconType="Outline"
									IsEnabled="{x:Bind DynamicEnabledToggle.IsOn, Mode=OneWay}"
									IsHighContrast="{x:Bind DynamicHighContrastToggle.IsOn, Mode=OneWay}"
									IsToggled="{x:Bind DynamicToggledToggle.IsOn, Mode=OneWay}"
									Data="{StaticResource IconTest}" />
							</Border>
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource TextExampleCaptionStyle}" Text="Outline" />
						</StackPanel>
					</Grid>

					<TextBlock
						Style="{StaticResource TextExampleCaptionStyle}"
						Text="Regression focus: Filled false → true toggle, and disabled → enabled while toggled."
						TextWrapping="Wrap" />
				</StackPanel>
			</controls:SamplePanel.MainContent>
			<controls:SamplePanel.SideContent>
				<StackPanel Spacing="12">
					<ToggleSwitch
						x:Name="DynamicToggledToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IsToggled"
						Header="IsToggled:"
						OffContent="False"
						OnContent="True" />
					<ToggleSwitch
						x:Name="DynamicEnabledToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IsEnabled"
						Header="IsEnabled:"
						IsOn="True"
						OffContent="Disabled"
						OnContent="Enabled" />
					<ToggleSwitch
						x:Name="DynamicHighContrastToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IsHighContrast"
						Header="IsHighContrast:"
						OffContent="False"
						OnContent="True" />
					<ToggleSwitch
						x:Name="DynamicDataToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.AlternateData"
						Header="Data:"
						OffContent="SetSlideshow"
						OnContent="Alternate diamond"
						Toggled="DynamicDataToggle_Toggled" />
					<ToggleSwitch
						x:Name="DynamicLoadedToggle"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IsLoaded"
						Header="Lifecycle:"
						IsOn="True"
						OffContent="Unloaded"
						OnContent="Loaded"
						Toggled="DynamicLoadedToggle_Toggled" />
					<ComboBox
						x:Name="DynamicSemanticColorComboBox"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IconColorType"
						Header="IconColorType:"
						SelectedIndex="0"
						SelectionChanged="DynamicSemanticColorComboBox_SelectionChanged">
						<ComboBoxItem Content="None" />
						<ComboBoxItem Content="Normal" />
						<ComboBoxItem Content="Critical" />
						<ComboBoxItem Content="Caution" />
						<ComboBoxItem Content="Success" />
						<ComboBoxItem Content="Neutral" />
						<ComboBoxItem Content="Accent" />
						<ComboBoxItem Content="Custom" />
					</ComboBox>
					<NumberBox
						x:Name="DynamicSizeNumberBox"
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.IconSize"
						Header="IconSize:"
						Maximum="64"
						Minimum="16"
						SpinButtonPlacementMode="Inline"
						Value="32" />
					<Button
						AutomationProperties.AutomationId="ThemedIcon2.Dynamic.Reset"
						Click="ResetDynamicSampleButton_Click"
						Content="Reset" />
				</StackPanel>
			</controls:SamplePanel.SideContent>
		</controls:SamplePanel>

		<!--  Icon Types and Colors  -->
		<controls:SamplePanel Header="Icon Types and Colors">
			<controls:SamplePanel.MainContent>
				<Grid ColumnSpacing="16" RowSpacing="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!--  Icon Column Headers  -->
					<TextBlock
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource TextExampleCaptionStyle}"
						Text="Layered" />

					<TextBlock
						Grid.Row="0"
						Grid.Column="2"
						Style="{StaticResource TextExampleCaptionStyle}"
						Text="Filled" />

					<TextBlock
						Grid.Row="0"
						Grid.Column="3"
						Style="{StaticResource TextExampleCaptionStyle}"
						Text="Outline" />

					<!--  Icon Row Headers  -->
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="Normal" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						MaxLines="1"
						Text="Disabled" />

					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Text="Success" />

					<TextBlock
						Grid.Row="4"
						Grid.Column="0"
						Text="Caution" />

					<TextBlock
						Grid.Row="5"
						Grid.Column="0"
						Text="Critical" />

					<TextBlock
						Grid.Row="6"
						Grid.Column="0"
						Text="Accent" />

					<TextBlock
						Grid.Row="7"
						Grid.Column="0"
						Text="Neutral" />

					<TextBlock
						Grid.Row="8"
						Grid.Column="0"
						Text="Custom" />

					<!--  Normal Icons Row 1  -->
					<controls:ThemedIcon2
						Grid.Row="1"
						Grid.Column="1"
						IconColorType="Normal"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="1"
						Grid.Column="2"
						IconColorType="Normal"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="1"
						Grid.Column="3"
						IconColorType="Normal"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Disabled Icons Row 2  -->
					<controls:ThemedIcon2
						Grid.Row="2"
						Grid.Column="1"
						IconType="Layered"
						IsEnabled="False"
						Data="{StaticResource IconTest}" />
					<controls:ThemedIcon2
						Grid.Row="2"
						Grid.Column="2"
						IsEnabled="False"
						IsFilled="True"
						Data="{StaticResource IconTest}" />
					<controls:ThemedIcon2
						Grid.Row="2"
						Grid.Column="3"
						IconType="Outline"
						IsEnabled="False"
						Data="{StaticResource IconTest}" />

					<!--  Success Icons Row 3  -->
					<controls:ThemedIcon2
						Grid.Row="3"
						Grid.Column="1"
						IconColorType="Success"
						IconType="Layered"
						Data="{StaticResource IconTest}" />
					<controls:ThemedIcon2
						Grid.Row="3"
						Grid.Column="2"
						IconColorType="Success"
						IsFilled="True"
						Data="{StaticResource IconTest}" />
					<controls:ThemedIcon2
						Grid.Row="3"
						Grid.Column="3"
						IconColorType="Success"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Caution Icons Row 4  -->
					<controls:ThemedIcon2
						Grid.Row="4"
						Grid.Column="1"
						IconColorType="Caution"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="4"
						Grid.Column="2"
						IconColorType="Caution"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="4"
						Grid.Column="3"
						IconColorType="Caution"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Critical Icons Row 5  -->
					<controls:ThemedIcon2
						Grid.Row="5"
						Grid.Column="1"
						IconColorType="Critical"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="5"
						Grid.Column="2"
						IconColorType="Critical"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="5"
						Grid.Column="3"
						IconColorType="Critical"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Accent Icons Row 6  -->
					<controls:ThemedIcon2
						Grid.Row="6"
						Grid.Column="1"
						IconColorType="Accent"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="6"
						Grid.Column="2"
						IconColorType="Accent"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="6"
						Grid.Column="3"
						IconColorType="Accent"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Neutral Icons Row 7  -->
					<controls:ThemedIcon2
						Grid.Row="7"
						Grid.Column="1"
						IconColorType="Neutral"
						IconType="Layered"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="7"
						Grid.Column="2"
						IconColorType="Neutral"
						IsFilled="True"
						Data="{StaticResource IconTest}" />

					<controls:ThemedIcon2
						Grid.Row="7"
						Grid.Column="3"
						IconColorType="Neutral"
						IconType="Outline"
						Data="{StaticResource IconTest}" />

					<!--  Custom Icons Row 8  -->
					<controls:ThemedIcon2
						Grid.Row="8"
						Grid.Column="1"
						Foreground="Cyan"
						IconColorType="Custom"
						IconType="Layered"
						Data="{StaticResource IconTest}">
						<controls:ThemedIcon2.Color>
							<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
								<GradientStop Offset="0.0" Color="PaleVioletRed" />
								<GradientStop Offset="1.0" Color="Red" />
							</LinearGradientBrush>
						</controls:ThemedIcon2.Color>
					</controls:ThemedIcon2>

					<controls:ThemedIcon2
						Grid.Row="8"
						Grid.Column="2"
						IconColorType="Custom"
						IsFilled="True"
						Data="{StaticResource IconTest}">
						<controls:ThemedIcon2.Color>
							<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
								<GradientStop Offset="0.0" Color="PaleGoldenrod" />
								<GradientStop Offset="1.0" Color="Orange" />
							</LinearGradientBrush>
						</controls:ThemedIcon2.Color>
					</controls:ThemedIcon2>

					<controls:ThemedIcon2
						Grid.Row="8"
						Grid.Column="3"
						IconColorType="Custom"
						IconType="Outline"
						Data="{StaticResource IconTest}">
						<controls:ThemedIcon2.Color>
							<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
								<GradientStop Offset="0.0" Color="PaleTurquoise" />
								<GradientStop Offset="1.0" Color="Teal" />
							</LinearGradientBrush>
						</controls:ThemedIcon2.Color>
					</controls:ThemedIcon2>

				</Grid>
			</controls:SamplePanel.MainContent>
		</controls:SamplePanel>

		<!--  Theme resource resolution  -->
		<controls:SamplePanel Header="Light and dark theme resources">
			<controls:SamplePanel.MainContent>
				<Grid ColumnSpacing="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border
						Grid.Column="0"
						Padding="16"
						Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						CornerRadius="{ThemeResource ControlCornerRadius}"
						RequestedTheme="Light">
						<StackPanel Spacing="12">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Light" />
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Normal" />
							<StackPanel Orientation="Horizontal" Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Normal.Layered" IconType="Layered" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Normal.Filled" IsFilled="True" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Normal.Outline" IconType="Outline" Data="{StaticResource IconTest}" />
							</StackPanel>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Toggled" />
							<StackPanel
								Padding="8"
								HorizontalAlignment="Left"
								Background="{ThemeResource ToggleBackground}"
								CornerRadius="{ThemeResource OverlayCornerRadius}"
								Orientation="Horizontal"
								Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Toggled.Layered" IconType="Layered" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Toggled.Filled" IsFilled="True" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.Toggled.Outline" IconType="Outline" ToggleBehavior="On" Data="{StaticResource IconTest}" />
							</StackPanel>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Disabled toggled" />
							<StackPanel
								Padding="8"
								HorizontalAlignment="Left"
								Background="{ThemeResource ToggleDisabledBackground}"
								CornerRadius="{ThemeResource OverlayCornerRadius}"
								Orientation="Horizontal"
								Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.DisabledToggled.Layered" IconType="Layered" IsEnabled="False" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.DisabledToggled.Filled" IsEnabled="False" IsFilled="True" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Light.DisabledToggled.Outline" IconType="Outline" IsEnabled="False" ToggleBehavior="On" Data="{StaticResource IconTest}" />
							</StackPanel>
						</StackPanel>
					</Border>

					<Border
						Grid.Column="1"
						Padding="16"
						Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						CornerRadius="{ThemeResource ControlCornerRadius}"
						RequestedTheme="Dark">
						<StackPanel Spacing="12">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Dark" />
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Normal" />
							<StackPanel Orientation="Horizontal" Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Normal.Layered" IconType="Layered" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Normal.Filled" IsFilled="True" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Normal.Outline" IconType="Outline" Data="{StaticResource IconTest}" />
							</StackPanel>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Toggled" />
							<StackPanel
								Padding="8"
								HorizontalAlignment="Left"
								Background="{ThemeResource ToggleBackground}"
								CornerRadius="{ThemeResource OverlayCornerRadius}"
								Orientation="Horizontal"
								Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Toggled.Layered" IconType="Layered" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Toggled.Filled" IsFilled="True" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.Toggled.Outline" IconType="Outline" ToggleBehavior="On" Data="{StaticResource IconTest}" />
							</StackPanel>
							<TextBlock Style="{StaticResource TextExampleCaptionStyle}" Text="Disabled toggled" />
							<StackPanel
								Padding="8"
								HorizontalAlignment="Left"
								Background="{ThemeResource ToggleDisabledBackground}"
								CornerRadius="{ThemeResource OverlayCornerRadius}"
								Orientation="Horizontal"
								Spacing="16">
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.DisabledToggled.Layered" IconType="Layered" IsEnabled="False" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.DisabledToggled.Filled" IsEnabled="False" IsFilled="True" ToggleBehavior="On" Data="{StaticResource IconTest}" />
								<controls:ThemedIcon2 AutomationProperties.AutomationId="ThemedIcon2.Theme.Dark.DisabledToggled.Outline" IconType="Outline" IsEnabled="False" ToggleBehavior="On" Data="{StaticResource IconTest}" />
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>
			</controls:SamplePanel.MainContent>
		</controls:SamplePanel>

		<!--  Toggled usages  -->
		<controls:SamplePanel Header="Toggled usages">
			<controls:SamplePanel.MainContent>
				<StackPanel Spacing="12">

					<TextBlock Text="HighContrast Manual Toggle:" />

					<StackPanel
						Padding="8"
						Orientation="Horizontal"
						Spacing="16">
						<controls:ThemedIcon2
							IconType="Layered"
							IsHighContrast="{x:Bind ContrastToggle.IsOn, Mode=TwoWay}"
							Data="{StaticResource IconTest}" />
						<controls:ThemedIcon2
							IsFilled="True"
							IsHighContrast="{x:Bind ContrastToggle.IsOn, Mode=TwoWay}"
							Data="{StaticResource IconTest}" />
						<controls:ThemedIcon2
							IconType="Outline"
							IsHighContrast="{x:Bind ContrastToggle.IsOn, Mode=TwoWay}"
							Data="{StaticResource IconTest}" />
					</StackPanel>

					<TextBlock Text="ToggleBehavior On:" />

					<StackPanel
						Padding="8"
						HorizontalAlignment="Left"
						Background="{ThemeResource ToggleBackground}"
						CornerRadius="{ThemeResource OverlayCornerRadius}"
						Orientation="Horizontal"
						Spacing="16">
						<controls:ThemedIcon2
							IconType="Layered"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
						<controls:ThemedIcon2
							IsFilled="True"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
						<controls:ThemedIcon2
							IconType="Outline"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
					</StackPanel>

					<TextBlock Text="ToggleBehavior On + Disabled:" />

					<StackPanel
						Padding="8"
						HorizontalAlignment="Left"
						Background="{ThemeResource ToggleDisabledBackground}"
						CornerRadius="{ThemeResource OverlayCornerRadius}"
						Orientation="Horizontal"
						Spacing="16">
						<controls:ThemedIcon2
							IconType="Layered"
							IsEnabled="False"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
						<controls:ThemedIcon2
							IsEnabled="False"
							IsFilled="True"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
						<controls:ThemedIcon2
							IconType="Outline"
							IsEnabled="False"
							Data="{StaticResource IconTest}"
							ToggleBehavior="On" />
					</StackPanel>

					<TextBlock Text="IsFilled:" />

					<StackPanel
						Padding="8"
						Orientation="Horizontal"
						Spacing="16">
						<controls:ThemedIcon2
							IconType="Layered"
							IsFilled="{x:Bind FilledToggle.IsOn, Mode=TwoWay}"
							Data="{StaticResource IconTest}" />
						<controls:ThemedIcon2
							IconType="Outline"
							IsFilled="{x:Bind FilledToggle.IsOn, Mode=TwoWay}"
							Data="{StaticResource IconTest}" />
					</StackPanel>

				</StackPanel>
			</controls:SamplePanel.MainContent>
			<controls:SamplePanel.SideContent>
				<StackPanel Spacing="8">

					<ToggleSwitch
						x:Name="ContrastToggle"
						Header="High contrast:"
						IsOn="True" />

					<ToggleSwitch
						x:Name="FilledToggle"
						Header="IsFilled:"
						IsOn="True"
						OffContent="False (Default)"
						OnContent="True" />

				</StackPanel>
			</controls:SamplePanel.SideContent>
		</controls:SamplePanel>

