						<AppBarButton
							AutomationProperties.Name="TestAppBarToggle2-1"
							HighContrastAdjustment="None"
							Label="Layered"
							LabelPosition="Default">
							<AppBarButton.Content>
								<controls:ThemedIcon2
									IconType="Layered"
									Data="{StaticResource IconTest}"
									ToggleBehavior="Off" />
							</AppBarButton.Content>
						</AppBarButton>

						<AppBarToggleButton
							AutomationProperties.Name="TestAppBarToggle2-2"
							HighContrastAdjustment="None"
							IsChecked="True"
							Label="Layered Toggle"
							LabelPosition="Default">
							<AppBarToggleButton.Content>
								<controls:ThemedIcon2
									IconType="Layered"
									Data="{StaticResource IconTest}"
									ToggleBehavior="Off" />
							</AppBarToggleButton.Content>
						</AppBarToggleButton>

						<AppBarButton
							AutomationProperties.Name="TestAppBarToggle2-3"
							HighContrastAdjustment="None"
							IsEnabled="{x:Bind OffEnabledToggle.IsOn, Mode=TwoWay}"
							Label="Disabled"
							LabelPosition="Default">
							<AppBarButton.Content>
								<controls:ThemedIcon2
									IconType="Layered"
									Data="{StaticResource IconTest}"
									ToggleBehavior="Off" />
							</AppBarButton.Content>
						</AppBarButton>

						<AppBarToggleButton
							AutomationProperties.Name="TestAppBarToggle2-4"
							HighContrastAdjustment="None"
							IsChecked="True"
							IsEnabled="{x:Bind OffEnabledToggle.IsOn, Mode=TwoWay}"
							Label="Layered Toggled Disabled"
							LabelPosition="Default">
							<AppBarToggleButton.Content>
								<controls:ThemedIcon2
									IconType="Layered"
									Data="{StaticResource IconTest}"
									ToggleBehavior="Off" />
							</AppBarToggleButton.Content>
						</AppBarToggleButton>
					</StackPanel>

					<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal"
						Spacing="16">
						<AppBarButton
							AutomationProperties.Name="TestAppBarToggle3-1"
							HighContrastAdjustment="None"
							Label="Outline"
							LabelPosition="Default">
							<AppBarButton.Content>
								<controls:ThemedIcon2
									IconType="Outline"
									Data="{StaticResource IconTest}"
									ToggleBehavior="Off" />
